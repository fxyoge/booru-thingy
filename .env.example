OWNER_LOGIN=owner
OWNER_API_KEY=replace-with-a-long-random-key
BASE_URL=http://localhost:8080
# Use a long random URL-safe password (e.g. generated with openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgres://booru:${POSTGRES_PASSWORD}@localhost:5432/booru
S3_ENDPOINT=http://localhost:9000
# Client-reachable origin used for media downloads and direct browser uploads.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=booru
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key
